// Prisma schema for LOOP Platform (PostgreSQL target for Neon / Supabase)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ANALYST")
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  reports      Report[]

  @@index([workspaceId])
}

model Feedback {
  id            String          @id @default(cuid())
  content       String          @db.Text
  channel       String
  sourceRef     String?
  customerLabel String?
  sentiment     String          @default("NEU")
  sentimentScore Float          @default(0.0)
  status        String          @default("NEW")
  createdAt     DateTime        @default(now())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes        FeedbackTheme[]
  embedding     Embedding?

  @@index([workspaceId])
  @@index([sentiment])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  color       String          @default("#6366f1")
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    FeedbackTheme[]

  @@index([workspaceId])
  @@unique([workspaceId, name])
}

model FeedbackTheme {
  id         String   @id @default(cuid())
  feedbackId String
  themeId    String
  confidence Float    @default(1.0)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, themeId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     String   @db.Text
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id            String    @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   String    @db.Text
  createdAt     DateTime  @default(now())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedById String
  generatedBy   User      @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
